---
// Small torn-paper chip: page numbers, "SKETCH" / "IDEA" tags, color swatch captions.
interface Props {
  tilt?: boolean;
}
const { tilt = false } = Astro.props;
---

<span class:list={['paper-label', 'typewriter', { tilt }]}><slot /></span>

<style>
  .paper-label {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--color-label);
    color: var(--color-ink);
    border-radius: var(--radius-paper);
    box-shadow: var(--shadow-paper);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .tilt {
    rotate: var(--tilt);
  }
</style>
