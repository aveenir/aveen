---
// Opening of a chapter page, rebuilt from the portfolio's chapter covers
// (p.5, 7, 13, 17): character on one side, chalk typewriter title on the
// horizon, chapter number on a paper label.
// The character is a raster crop with the PDF's paper baked in (TD-002), so the
// section's horizon is moved to where the crop's own horizon sits (`horizon`).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import PaperLabel from './PaperLabel.astro';
import { chapterNumber, useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  number: number;
  title: string;
  /** Latin chalk title as printed in the PDF; decorative. Omit when the crop already shows it. */
  display?: string;
  lead: string;
  image: ImageMetadata;
  alt: string;
  /** 0–1: height of the light paper inside the crop. */
  horizon: number;
}
const { locale, number, title, display, lead, image, alt, horizon } = Astro.props;
const t = useTranslations(locale);
---

<section class="chapter-hero" style={`--art-horizon: ${horizon * 100}%`}>
  <div class="art">
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1080].filter((w) => w <= image.width)}
      sizes="(min-width: 64rem) 55vw, 100vw"
      loading="eager"
      fetchpriority="high"
      data-reveal
    />
  </div>
  <div class="copy">
    <PaperLabel tilt>{`${t('chapter.label')} ${chapterNumber(number, locale)}`}</PaperLabel>
    <h1 class="heading">{title}</h1>
    {/* Persian pages echo the PDF's Latin chalk title; on English pages it would repeat the h1. */}
    {display && locale === 'fa' && <p class="display" lang="en" aria-hidden="true">{display}</p>}
    <p class="lead">{lead}</p>
  </div>
</section>

<style>
  .chapter-hero {
    display: grid;
  }
  .art {
    background: linear-gradient(
      to bottom,
      var(--color-paper) 0 var(--art-horizon),
      var(--color-paper-deep) var(--art-horizon) 100%
    );
  }
  .art :global(img) {
    margin-inline: auto;
    max-block-size: 70dvh;
    inline-size: auto;
  }
  .copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-8) var(--page-gutter) var(--space-12);
    background: var(--color-paper-deep);
  }
  .display {
    font-size: var(--text-2xl);
    overflow-wrap: anywhere;
  }
  .lead {
    max-inline-size: var(--measure);
    font-size: var(--text-lg);
  }

  @media (min-width: 64rem) {
    .chapter-hero {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      background: linear-gradient(
        to bottom,
        var(--color-paper) 0 var(--art-horizon),
        var(--color-paper-deep) var(--art-horizon) 100%
      );
    }
    .art {
      background: none;
    }
    .art :global(img) {
      max-block-size: 80dvh;
    }
    .copy {
      background: none;
      padding-block: var(--space-12);
    }
  }
</style>
