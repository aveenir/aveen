---
// Shared SVG filters. Included once by BaseLayout.
// #crayon roughens strokes so vector lines read as charcoal/crayon on paper.
---

<svg class="visually-hidden" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <filter id="crayon" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="noise"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.2" xChannelSelector="R" yChannelSelector="G"
      ></feDisplacementMap>
    </filter>
  </defs>
</svg>
