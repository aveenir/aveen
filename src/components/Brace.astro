---
// Hand-drawn orange curly brace that groups a list (portfolio p.3, p.4).
// Sits on the inline-start side and opens toward the content in both directions.
// Stretches to the block size of its grid/flex row.
---

<svg class="brace" viewBox="0 0 40 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path
    data-draw
    pathLength="1"
    d="M31 4 C13 5 19 42 18 70 C18 88 13 97 4 100 C14 104 18 113 18 130 C19 160 13 195 31 196"
  ></path>
</svg>

<style>
  .brace {
    inline-size: 1.75rem;
    /* auto + stretch: a percentage height is cyclic here and would disable stretching */
    block-size: auto;
    align-self: stretch;
    min-block-size: 3rem;
    flex: none;
    overflow: visible;
    filter: url(#crayon);
  }
  :global([dir='rtl']) .brace {
    scale: -1 1;
  }
  path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* no non-scaling-stroke: it breaks pathLength-based dash drawing */
  }
</style>
