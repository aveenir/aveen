---
// Closing page (portfolio p.26): handshake with a sprout beside email and phone.
// The crop leaves out the page's lettering, so each detail appears once.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contact } from '@/site';
import { useTranslations, type Locale } from '@/i18n/ui';
import handshake from '@/assets/pdf/contact-handshake.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('contact.title')} description={t('contact.lead')} chapter="contact">
  <section class="contact">
    <div class="wrap grid">
      <Image
        class="art"
        src={handshake}
        alt={t('contact.handshake.alt')}
        widths={[640, 960, 1320]}
        sizes="(min-width: 64rem) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="card">
        <h1 class="heading">{t('contact.cta')}</h1>
        <p class="lead">{t('contact.lead')}</p>
        <dl>
          <div>
            <dt class="typewriter">{t('contact.email')}</dt>
            <dd><a href={`mailto:${contact.email}`} lang="en" dir="ltr">{contact.email}</a></dd>
          </div>
          <div>
            <dt class="typewriter">{t('contact.phone')}</dt>
            <dd><a href={`tel:${contact.phone}`} lang="en" dir="ltr">{contact.phoneDisplay}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    background: var(--color-paper-deep);
    padding-block: var(--space-8) var(--space-16);
  }
  .grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  .art {
    inline-size: 100%; /* whole artwork, never cropped */
    border-radius: var(--radius-paper);
    box-shadow: var(--shadow-paper);
  }
  .card {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
  .lead {
    max-inline-size: var(--measure);
    font-size: var(--text-lg);
  }
  dl {
    display: grid;
    gap: var(--space-4);
  }
  dt {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  dd a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    font-family: var(--font-latin);
    font-size: var(--text-xl);
    overflow-wrap: anywhere;
  }
</style>
