---
// Closing page (portfolio p.26): handshake with a sprout, email and phone.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contact } from '@/site';
import { useTranslations, type Locale } from '@/i18n/ui';
import handshake from '@/assets/pdf/contact-handshake.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('contact.title')} description={t('contact.lead')} chapter="contact">
  <section class="contact">
    <Image
      class="art"
      src={handshake}
      alt={t('contact.handshake.alt')}
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap card">
      <h1 class="heading">{t('contact.cta')}</h1>
      <p class="lead">{t('contact.lead')}</p>
      <dl>
        <div>
          <dt class="typewriter">{t('contact.email')}</dt>
          <dd><a href={`mailto:${contact.email}`} lang="en" dir="ltr">{contact.email}</a></dd>
        </div>
        <div>
          <dt class="typewriter">{t('contact.phone')}</dt>
          <dd><a href={`tel:${contact.phone}`} lang="en" dir="ltr">{contact.phoneDisplay}</a></dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    background: var(--color-paper-deep);
    padding-block-end: var(--space-16);
  }
  .art {
    inline-size: 100%;
    max-block-size: 80dvh;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .card {
    display: grid;
    gap: var(--space-6);
    padding-block-start: var(--space-8);
  }
  .lead {
    max-inline-size: var(--measure);
    font-size: var(--text-lg);
  }
  dl {
    display: grid;
    gap: var(--space-4);
  }
  dt {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  dd a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    font-family: var(--font-latin);
    font-size: var(--text-xl);
    overflow-wrap: anywhere;
  }
</style>
