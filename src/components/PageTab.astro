---
// The mint page-number tab from the portfolio's bottom corner (every page).
// Shows the chapter number, links back to the top, and its edge fills with
// reading progress where scroll-driven animations are supported.
import { chapterNumber, useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  number: number;
}
const { locale, number } = Astro.props;
const t = useTranslations(locale);
---

<a class="page-tab typewriter" href="#top" aria-label={t('footer.top')}>
  <span aria-hidden="true">{chapterNumber(number, locale)}</span>
</a>

<style>
  .page-tab {
    display: none; /* phones: a fixed tab would sit on top of the text */
    position: fixed;
    inset-block-end: 0;
    inset-inline-start: 0;
    z-index: var(--z-tab);
    place-items: center;
    min-inline-size: 3.5rem;
    min-block-size: 3rem;
    padding-inline: var(--space-3);
    background: var(--color-label);
    color: var(--color-ink);
    font-size: var(--text-lg);
    text-decoration: none;
    box-shadow: var(--shadow-paper);
    border-start-end-radius: var(--radius-paper);
    overflow: hidden;
  }
  @media (min-width: 48rem) {
    .page-tab {
      display: grid;
    }
  }
  .page-tab::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    block-size: 4px;
    background: var(--color-accent);
    transform-origin: 0 50%;
    scale: 0 1;
  }
  :global([dir='rtl']) .page-tab::before {
    transform-origin: 100% 50%;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .page-tab::before {
        animation: progress linear both;
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes progress {
    to {
      scale: 1 1;
    }
  }
</style>
