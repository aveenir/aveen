---
// An artwork that opens larger in the lightbox (Lightbox.astro). Without JS the
// link simply opens the large image.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  src: ImageMetadata;
  alt: string;
  locale: Locale;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
}
const { src, alt, locale, sizes, widths = [480, 800, 1200, 1600], loading = 'lazy' } = Astro.props;
const t = useTranslations(locale);
const large = await getImage({ src, width: Math.min(src.width, 1920), format: 'webp' });
const usable = widths.filter((w) => w <= src.width);
---

<a class="zoomable" href={large.src} data-zoom data-zoom-alt={alt}>
  <Image src={src} alt={alt} widths={usable.length ? usable : [src.width]} sizes={sizes} loading={loading} />
  <span class="visually-hidden">{t('gallery.open')}</span>
</a>

<style>
  .zoomable {
    display: block;
    cursor: zoom-in;
    border-radius: var(--radius-paper);
  }
  .zoomable :global(img) {
    inline-size: 100%;
    block-size: auto;
    box-shadow: var(--shadow-paper);
    transition: translate var(--dur-base) var(--ease-out);
  }
  .zoomable:hover :global(img) {
    translate: 0 -3px;
  }
</style>
