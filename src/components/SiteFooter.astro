---
// Closing strip of every page: name, email, phone and the language switch.
// Kept to one short dark row so it reads as the end of the page, not as one
// more sage section. The contact page already lists email and phone, so the
// footer drops them there (`withContact`).
import LangSwitch from './LangSwitch.astro';
import { contact } from '@/site';
import { useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  withContact?: boolean;
}
const { locale, withContact = true } = Astro.props;
const t = useTranslations(locale);
---

<footer class="site-footer">
  <div class="wrap row">
    <p class="sign">© {t('site.title')}</p>
    {
      withContact && (
        <ul class="links" role="list">
          <li>
            <span class="visually-hidden">{t('contact.email')}: </span>
            <a href={`mailto:${contact.email}`} lang="en" dir="ltr">{contact.email}</a>
          </li>
          <li>
            <span class="visually-hidden">{t('contact.phone')}: </span>
            <a href={`tel:${contact.phone}`} lang="en" dir="ltr">{contact.phoneDisplay}</a>
          </li>
        </ul>
      )
    }
    <LangSwitch locale={locale} />
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6);
    background: var(--color-night);
    color: var(--color-on-night);
    border-block-start: 1px solid var(--color-on-night);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-8);
  }
  .sign {
    margin-inline-end: auto; /* name at the start, everything else at the end */
    font-size: var(--text-sm);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    order: 3; /* phones: name and language on one line, contacts below */
    flex-basis: 100%;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    font-family: var(--font-latin);
    font-size: var(--text-sm);
  }
  .row > :global(.lang) {
    color: var(--color-ink);
  }
  @media (min-width: 48rem) {
    .row {
      padding-inline-start: var(--space-16); /* clear the fixed page tab */
    }
    .links {
      order: 0;
      flex-basis: auto;
    }
  }
</style>
